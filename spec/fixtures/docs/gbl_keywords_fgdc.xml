<?xml version="1.0"?>
<!--
  Hand-authored fixture. No record in the wild (yet) uses the GBL controlled
  thesaurus names in <themekt>, but they are the priority-1 source for
  gbl_resourceClass_sm, gbl_resourceType_sm and dcat_theme_sm in the
  FGDC -> Aardvark crosswalk.

  The <geoform> and <sdtstype> values below deliberately DISAGREE with the
  explicit keywords so that the specs can prove the keywords win:

    geoform  "vector digital data" would infer Datasets, but
             themekt "GBL Resource Class" says Maps
    sdtstype "G-polygon"           would infer Polygon data, but
             themekt "GBL Resource Type"  says Image data
-->
